SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=madrasah_library
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Full path to pg_dump.exe (Windows) if it is not on PATH.
# Find it under the Postgres install, e.g. C:\Program Files\PostgreSQL\<version>\bin\pg_dump.exe
PGDUMP_PATH=
# Directory (relative to project root, or absolute) where `python manage.py backup_db` writes dumps.
BACKUP_DIR=backups
