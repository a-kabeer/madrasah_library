SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=madrasah_library
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# See docs/DATABASE.md "Running tests" for how to create this database once.
DB_TEST_NAME=madrasah_library_test

# Full path to pg_dump.exe (Windows) if it is not on PATH.
# Find it under the Postgres install, e.g. C:\Program Files\PostgreSQL\<version>\bin\pg_dump.exe
PGDUMP_PATH=
# Directory (relative to project root, or absolute) where `python manage.py backup_db` writes dumps.
BACKUP_DIR=backups

# --- Production-only (leave blank for local dev) ---
# Comma-separated list of https:// origins allowed to submit forms here,
# e.g. https://your-app.onrender.com — required by Django's CSRF check for
# HTTPS deployments. On Render specifically this isn't needed: the app
# picks up RENDER_EXTERNAL_HOSTNAME automatically.
CSRF_TRUSTED_ORIGINS=
# Force these on explicitly if you're ever behind DEBUG=True on a real
# public domain; otherwise they follow DEBUG automatically (on when
# DEBUG=False, off when DEBUG=True).
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
# Seconds for HTTP Strict Transport Security. Leave at 0 until you're sure
# HTTPS is solid — start low (e.g. 3600) and raise it once verified.
SECURE_HSTS_SECONDS=0
