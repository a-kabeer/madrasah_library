SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=madrasah_library
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# See docs/DATABASE.md "Running tests" for how to create this database once.
DB_TEST_NAME=madrasah_library_test

# Seconds to keep a database connection open between requests. Django's own
# default is 0 — connect and disconnect around every page — which on a
# managed Postgres costs more than the queries do. Raise the Gunicorn worker
# count and this becomes workers x connections, which is what to watch
# against the database's own limit.
CONN_MAX_AGE=60

# Full path to pg_dump.exe (Windows) if it is not on PATH.
# Find it under the Postgres install, e.g. C:\Program Files\PostgreSQL\<version>\bin\pg_dump.exe
PGDUMP_PATH=
# Directory (relative to project root, or absolute) where `python manage.py backup_db` writes dumps.
BACKUP_DIR=backups

# --- Mail (leave blank for local dev) ---
# Nothing in the app sends mail yet. Blank keeps the console backend, which
# prints a message to the terminal rather than losing it. Set EMAIL_HOST and
# the backend switches to SMTP - which is also what stops
# `manage.py check --deploy` failing with mail.E001, since a console backend
# with DEBUG off means anything sent goes to stdout and nobody is told.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=madrasah-library@localhost

# --- Logging ---
# Everything goes to stderr, which Render, systemd and `docker logs` all
# collect. DEBUG here means Python's log level, not Django's DEBUG setting.
LOG_LEVEL=INFO
# Raise to DEBUG to see every SQL statement. Very loud; for a session, not
# for a deployment.
SQL_LOG_LEVEL=WARNING

# --- Production-only (leave blank for local dev) ---
# Comma-separated list of https:// origins allowed to submit forms here,
# e.g. https://your-app.onrender.com — required by Django's CSRF check for
# HTTPS deployments. On Render specifically this isn't needed: the app
# picks up RENDER_EXTERNAL_HOSTNAME automatically.
CSRF_TRUSTED_ORIGINS=
# Force these on explicitly if you're ever behind DEBUG=True on a real
# public domain; otherwise they follow DEBUG automatically (on when
# DEBUG=False, off when DEBUG=True).
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
# Seconds for HTTP Strict Transport Security. Leave at 0 until you're sure
# HTTPS is solid — start low (e.g. 3600) and raise it once verified.
SECURE_HSTS_SECONDS=0
# These two are separate decisions from the one above and from each other.
# includeSubDomains commits every subdomain of this host to HTTPS, which
# breaks a plain-HTTP one you had forgotten about; preload asks browsers to
# ship the commitment in their source, which is effectively irreversible.
# Turn them on deliberately, after SECURE_HSTS_SECONDS has been high for a
# while without trouble.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
