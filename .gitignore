# Environment / secrets
.env

# Python
__pycache__/
*.pyc
venv/

# Django
*.log
staticfiles/

# Uploaded spreadsheets waiting to be imported. Deliberately outside
# MEDIA_ROOT so they are never served, and never committed.
private/

# User uploads (book covers) — belong in storage, not in the repo
media/

# Database backups (contain real data — never commit)
backups/*.dump
backups/*.sql

# Editor
.vscode/

# Claude Code local state
.claude/

# Scratch directory listings
file_list.txt

# Compiled translation catalogues - built by `manage.py compilemessages`
locale/*/LC_MESSAGES/*.mo
